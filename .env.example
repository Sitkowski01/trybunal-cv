# Skopiuj do .env (plik .env jest w .gitignore). Czytaja go: pnpm trial (CLI) i pnpm api (serwer).
ANTHROPIC_API_KEY=
# Rozprawy bez modelu i bez klucza (demo, frontend, e2e): 1
TRYBUNAL_REHEARSAL=0
# Przerwa (ms) przed kazda odpowiedzia proby generalnej, np. 800 - widac kolejne fazy na ekranie
TRYBUNAL_REHEARSAL_DELAY_MS=0

# Serwer API
PORT=3000
HOST=127.0.0.1
# Bez DATABASE_URL dziennik jest w pamieci i znika po restarcie.
DATABASE_URL=
# Wymagany z baza: 32 bajty base64 (openssl rand -base64 32). Utrata klucza = utrata wszystkich rozpraw.
TRYBUNAL_MASTER_KEY=
# Albo sciezka do pliku z kluczem (Docker: wolumen, sekret) - wtedy TRYBUNAL_MASTER_KEY zostaw puste.
TRYBUNAL_MASTER_KEY_FILE=
TRIAL_BUDGET_USD=0.5
DAILY_BUDGET_USD=5
MAX_RUNNING_TRIALS=3
RATE_LIMIT_PER_HOUR=5
# 1 za proxy (Docker, nginx): limit per adres klienta z X-Forwarded-For
TRUST_PROXY=0
